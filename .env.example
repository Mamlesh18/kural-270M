# Copy to .env (git-ignored) and export, or set in your shell / job scheduler.
# Nothing in this repository reads credentials from files; everything is env-driven.

# Where all generated artifacts go (data shards, tokenizers, checkpoints, reports).
KURAL_WORKSPACE=./workspace

# Base model. google/gemma-3-270m is gated: accept the license on the Hub and set HF_TOKEN.
KURAL_BASE_MODEL=google/gemma-3-270m
HF_TOKEN=

# Weights & Biases (leave WANDB_API_KEY empty and set WANDB_MODE=offline to log locally).
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=kural-270m
WANDB_MODE=online

# Optional tools
# Path to a fastText lid.176.bin model for extra language-id confirmation.
KURAL_FASTTEXT_LID=
# Path to a llama.cpp checkout (for GGUF export / quantization).
LLAMA_CPP_DIR=
